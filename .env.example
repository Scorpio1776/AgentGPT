# Deployment Environment:
NODE_ENV=development

# Next Auth config:
# Generate a secret with `openssl rand -base64 32`, or visit https://generate-secret.vercel.app/
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=http://localhost:3000

# Database:
DATABASE_URL=file:./db.sqlite

# AI APIs:
OPENAI_API_KEY=changeme

# Search API (optional - enable web search functionality):
SERP_API_KEY=changeme

# OAuth Providers (optional - required only if NEXT_PUBLIC_FF_AUTH_ENABLED=true):
# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme

# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=changeme
GITHUB_CLIENT_SECRET=changeme

# Discord OAuth - https://discord.com/developers/applications
DISCORD_CLIENT_ID=changeme
DISCORD_CLIENT_SECRET=changeme

# Stripe (optional - for subscriptions and donations):
STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme
STRIPE_SUBSCRIPTION_PRICE_ID=changeme
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=changeme
NEXT_PUBLIC_STRIPE_DONATION_ENABLED=false

# Rate Limiting (optional - requires Upstash Redis):
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=changeme
UPSTASH_REDIS_REST_TOKEN=changeme
RATE_LIMITER_REQUESTS_PER_MINUTE=60

# Feature Flags:
NEXT_PUBLIC_FF_AUTH_ENABLED=false
NEXT_PUBLIC_FF_SUB_ENABLED=false
NEXT_PUBLIC_FF_MOCK_MODE_ENABLED=false
NEXT_PUBLIC_WEB_SEARCH_ENABLED=true
NEXT_PUBLIC_FORCE_AUTH=false

# Vercel (auto-populated in production):
NEXT_PUBLIC_VERCEL_ENV=development
NEXT_PUBLIC_VERCEL_URL=http://localhost:3000
