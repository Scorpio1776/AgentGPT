# Deployment Environment:
NODE_ENV=development

# Next Auth config:
# Generate a secret with `openssl rand -base64 32`, or visit https://generate-secret.vercel.app/
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=http://localhost:3000

# Prisma
DATABASE_URL=file:./db.sqlite

# External APIs:
OPENAI_API_KEY=changeme

# Search API (optional - for web search functionality):
SERP_API_KEY=changeme

# Additional AI APIs (optional - not currently used in codebase):
# CLAUDE_API_KEY=changeme
# GEMINI_API_KEY=changeme
# PERPLEXITY_API_KEY=changeme
