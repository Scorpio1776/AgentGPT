# Deployment Environment:
NODE_ENV=development

# Next Auth config:
# Generate a secret with `openssl rand -base64 32`, or visit https://generate-secret.vercel.app/
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=http://localhost:3000

# Prisma
DATABASE_URL=file:./db.sqlite

# External APIs:
OPENAI_API_KEY=changeme

# OpenClaw Integration (formerly Moltbot):
# Webhook authentication token - generate with: openssl rand -hex 32
OPENCLAW_WEBHOOK_TOKEN=changeme
# OpenClaw gateway URL (if you want to send messages back)
OPENCLAW_GATEWAY_URL=http://localhost:8080
# Model to use for OpenClaw-triggered agents
OPENAI_MODEL_NAME=gpt-3.5-turbo
